# Answers in Faith Engine — Environment Variables

# Database (Railway PostgreSQL auto-provides DATABASE_URL)
DATABASE_URL=sqlite:///./answers_in_faith.db

# AI Providers
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=josh

# Video generation (Lumen-style provider chain)
# First configured provider in the order wins; placeholder is always last resort.
VIDEO_PROVIDER_ORDER=seedance,openai_image,placeholder
REPLICATE_API_TOKEN=r8_...
SEEDANCE_MODEL=bytedance/seedance-2.5
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=16:9
OPENAI_IMAGE_MODEL=gpt-image-1

# Cloudflare R2 (persistent video storage — REQUIRED or videos die on redeploy)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=from_r2_api_token_with_object_read_write
R2_SECRET_ACCESS_KEY=from_r2_api_token
R2_BUCKET_NAME=answerbible-videos
# The bucket's REAL public URL (Bucket -> Settings -> Public Development URL). NOT pub-<account_id>.
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# YouTube (OAuth 2.0 — download from Google Cloud Console)
YOUTUBE_CLIENT_SECRETS_PATH=config/client_secret.json
YOUTUBE_CREDENTIALS_PATH=config/youtube_credentials.json

# Production
FFMPEG_PATH=ffmpeg
OUTPUT_DIR=./output
